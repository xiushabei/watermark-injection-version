#include "resource.h"

#define IDC_STATIC (-1)
#define DS_MODALFRAME 0x80
#define WS_POPUP 0x80000000
#define WS_CAPTION 0xC00000
#define WS_SYSMENU 0x80000
#define SS_NOPREFIX 0x80

ID_MULTI_DIALOG DIALOGEX 0, 0, 420, 250
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "\u9009\u62E9 Minecraft \u7A97\u53E3"
FONT 9, "Microsoft YaHei"
{
    LTEXT "\u68C0\u6D4B\u5230\u591A\u4E2A Minecraft \u7A97\u53E3\uFF0C\u8BF7\u9009\u62E9\uFF1A",IDC_STATIC,15,15,390,15
    CONTROL "",ID_LIST_MINECRAFT,"LISTBOX",0x3 | 0x200000 | 0x10000,15,35,390,160
    CONTROL "Inject Selected",ID_BTN_SEL_INJECT,"BUTTON",0x0 | 0x10000,240,210,110,25
    CONTROL "Cancel",ID_BTN_SEL_CANCEL,"BUTTON",0x0 | 0x10000,360,210,60,25
}

// Embedded Watermark DLL - extracted to %APPDATA% at runtime and injected
IDR_WATERMARK_DLL RCDATA "WatermarkInjection.dll"
